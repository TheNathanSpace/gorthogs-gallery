# Copy to .env.local for `npm run dev`, or pass through docker compose.

# Required in production. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# Single keeper account. There is no public signup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Set true when the reverse proxy serves the site over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=reliquary_session
SESSION_TTL_SECONDS=604800

# Where SQLite and uploaded photographs live. In Docker this is /data.
DATA_DIR=./data

SITE_TITLE=The Reliquary
SITE_TAGLINE=A vault of painted miniatures

# Seed three labeled placeholder miniatures when the database is empty.
SEED_DEMO=true

MAX_UPLOAD_BYTES=20971520
DISPLAY_MAX_EDGE=2400
THUMB_MAX_EDGE=640

# Optional, build-time only. Comma-separated hosts for Server Action CSRF
# if your reverse proxy does not forward X-Forwarded-Host.
# SERVER_ACTION_ORIGINS=gallery.example.com
