# Copy to .env.local for `npm run dev`, or to .env for docker compose.
# Production: generate AUTH_SECRET, set PUBLIC_BASE_URL and AUTH_COOKIE_SECURE,
# set the vault key on a private network before opening the proxy. See README.

# Required in production (the container refuses to start without a real secret).
# Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# Single keeper account. There is no public signup.
# The password is not set here. First login is vault key "changeme";
# you then choose a lasting key (15+ characters) stored as a hash in SQLite.
ADMIN_USERNAME=admin

# Set false on an air-gapped host. Local common-password blocklist still applies.
# Unreachable HIBP fails open so a LAN-only vault can still set a key.
PWNED_PASSWORDS=true

# Set true when the reverse proxy serves the site over HTTPS.
# If PUBLIC_BASE_URL is https://…, production also requires this to be true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=reliquary_session
SESSION_TTL_SECONDS=604800

# Canonical public origin for Open Graph, sitemap, and the HTTPS cookie check.
# Example: https://minis.example.com
# PUBLIC_BASE_URL=http://127.0.0.1:3847

# UI language. English catalog ships first (en).
LOCALE=en

# Where SQLite and uploaded photographs live. In Docker this is /data.
DATA_DIR=./data

SITE_TITLE=The Reliquary
SITE_TAGLINE=A vault of painted miniatures

# Seed three labeled placeholder miniatures when the miniatures table is empty.
# Set false before the first production start for an empty vault.
SEED_DEMO=true

MAX_UPLOAD_BYTES=20971520
DISPLAY_MAX_EDGE=2400
THUMB_MAX_EDGE=640

# Optional, build-time only. Comma-separated hosts for Server Action CSRF
# if your reverse proxy does not forward X-Forwarded-Host.
# SERVER_ACTION_ORIGINS=gallery.example.com

# Published image from a GitHub Release (used with docker-compose.ghcr.yml).
# RELIQUARY_IMAGE=ghcr.io/<owner>/<repo>:v1.0.0
